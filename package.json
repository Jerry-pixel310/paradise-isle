{
  "name": "paradise-isle",
  "private": true,
  "version": "9.1.0",
  "type": "module",
  "description": "An island life-sim for the browser: farm, raise and breed animals, fish, ranch-craft, run a restaurant, decorate, dress up and visit neighbours.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portable": "npm run build && node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "server": "node server/index.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "mqtt": "^5.16.1"
  }
}
